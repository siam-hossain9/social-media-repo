    {
      "parameters": {
        "jsCode": "// Analyze performance and determine if content should be repurposed\nconst analyticsData = $input.item.json;\nconst originalContent = $('Prepare Final Content Package').item.json;\n\n// Simulate analytics parsing (Buffer API response)\nlet engagementScore = 0;\nlet clicks = 0;\nlet likes = 0;\nlet shares = 0;\nlet comments = 0;\n\ntry {\n  const interactions = analyticsData?.interactions || [];\n  clicks = interactions.filter(i => i.event === 'clicks').length;\n  likes = interactions.filter(i => i.event === 'likes').length;\n  shares = interactions.filter(i => i.event === 'shares').length;\n  comments = interactions.filter(i => i.event === 'comments').length;\n  \n  // Calculate engagement score (0-100)\n  engagementScore = Math.min(100, (\n    (clicks * 1) + \n    (likes * 2) + \n    (shares * 5) + \n    (comments * 3)\n  ));\n} catch(e) {\n  // Demo data for testing\n  clicks = Math.floor(Math.random() * 500);\n  likes = Math.floor(Math.random() * 200);\n  shares = Math.floor(Math.random() * 50);\n  comments = Math.floor(Math.random() * 30);\n  engagementScore = Math.floor(Math.random() * 100);\n}\n\n// Determine performance level\nlet performanceLevel = 'low';\nif (engagementScore >= 70) performanceLevel = 'viral';\nelse if (engagementScore >= 40) performanceLevel = 'high';\nelse if (engagementScore >= 20) performanceLevel = 'medium';\n\nreturn [{\n  json: {\n    ...originalContent,\n    analytics: {\n      clicks,\n      likes,\n      shares,\n      comments,\n      engagement_score: engagementScore,\n      performance_level: performanceLevel,\n      analyzed_at: new Date().toISOString()\n    },\n    should_repurpose: engagementScore >= 40\n  }\n}];"
      },
      "id": "4855bee7-b8c8-4f45-8d29-6f2e90ef70e2",
