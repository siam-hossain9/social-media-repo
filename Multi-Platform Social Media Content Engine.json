    {
      "parameters": {
        "jsCode": "// Combine all platform content for this topic\nconst calendarItem = $('Parse Content Calendar').item.json;\n\n// Get content from each platform node\nlet twitterContent, linkedinContent, instagramContent;\n\ntry {\n  const twitterRaw = $('AI Write Twitter Content').item.json;\n  const twitterText = twitterRaw.message?.content || twitterRaw.choices?.[0]?.message?.content || '{}';\n  twitterContent = JSON.parse(twitterText);\n} catch(e) {\n  twitterContent = {\n    single_tweet: `${calendarItem.hook} ${calendarItem.hashtagString}`,\n    thread: [],\n    image_prompt: `Professional tech illustration about ${calendarItem.topic}`\n  };\n}\n\ntry {\n  const linkedinRaw = $('AI Write LinkedIn Content').item.json;\n  const linkedinText = linkedinRaw.message?.content || linkedinRaw.choices?.[0]?.message?.content || '{}';\n  linkedinContent = JSON.parse(linkedinText);\n} catch(e) {\n  linkedinContent = {\n    headline: calendarItem.topic,\n    full_post: calendarItem.hook,\n    image_prompt: `Professional business illustration about ${calendarItem.topic}`\n  };\n}\n\ntry {\n  const instagramRaw = $('AI Write Instagram Content').item.json;\n  const instagramText = instagramRaw.message?.content || instagramRaw.choices?.[0]?.message?.content || '{}';\n  instagramContent = JSON.parse(instagramText);\n} catch(e) {\n  instagramContent = {\n    caption: `${calendarItem.hook} \\n\\n${calendarItem.hashtagString}`,\n    image_prompt: `Vibrant colorful illustration about ${calendarItem.topic}`\n  };\n}\n\nreturn [{\n  json: {\n    // Calendar data\n    topic_id: calendarItem.id,\n    topic: calendarItem.topic,\n    week_theme: calendarItem.week_theme,\n    content_type: calendarItem.content_type,\n    best_day: calendarItem.best_day,\n    best_time: calendarItem.best_time,\n    hashtags: calendarItem.hashtagString,\n    \n    // Platform content\n    twitter: twitterContent,\n    linkedin: linkedinContent,\n    instagram: instagramContent,\n    \n    // Image prompts (will use Twitter's by default for variety)\n    primary_image_prompt: twitterContent.image_prompt || `Professional illustration about ${calendarItem.topic}`,\n    \n    // Metadata\n    created_at: new Date().toISOString(),\n    status: 'ready_for_image'\n  }\n}];"
      },
