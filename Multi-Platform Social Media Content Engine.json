    {
      "parameters": {
        "jsCode": "// Parse the AI generated content calendar\nconst aiResponse = $input.item.json;\n\nlet calendarData;\ntry {\n  // Extract content from OpenAI response\n  const content = aiResponse.message?.content || aiResponse.choices?.[0]?.message?.content || '';\n  calendarData = JSON.parse(content);\n} catch(e) {\n  // Fallback data if parsing fails\n  calendarData = {\n    week_theme: 'AI & Automation Revolution',\n    content_ideas: [\n      {\n        id: 1,\n        topic: 'AI Tools for Productivity',\n        hook: '10 AI tools that replaced my entire team (not clickbait)',\n        core_message: 'AI is not replacing humans, its replacing humans who dont use AI',\n        call_to_action: 'Which tool do you use? Comment below!',\n        hashtags: ['#AI', '#Productivity', '#Tech', '#Automation', '#Future', '#ChatGPT', '#Tools', '#Innovation', '#Work', '#Digital'],\n        content_type: 'listicle',\n        best_day: 'Tuesday',\n        best_time: '9:00 AM EST'\n      }\n    ]\n  };\n}\n\n// Return each content idea as separate item for parallel processing\nconst items = calendarData.content_ideas.map(idea => ({\n  json: {\n    ...idea,\n    week_theme: calendarData.week_theme,\n    hashtagString: idea.hashtags.join(' ')\n  }\n}));\n\nreturn items;"
      },
