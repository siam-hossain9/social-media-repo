    {
      "parameters": {
        "jsCode": "// Prepare final content package with image URL\nconst contentData = $('Combine All Platform Content').item.json;\nconst dalleResponse = $input.item.json;\n\n// Extract image URL\nlet imageUrl = '';\ntry {\n  imageUrl = dalleResponse.data?.[0]?.url || \n             dalleResponse.images?.[0]?.url || \n             '';\n} catch(e) {\n  imageUrl = 'https://via.placeholder.com/1024x1024';\n}\n\n// Calculate schedule date based on best_day\nconst dayMap = {\n  'Monday': 1, 'Tuesday': 2, 'Wednesday': 3, \n  'Thursday': 4, 'Friday': 5, 'Saturday': 6, 'Sunday': 0\n};\n\nconst today = new Date();\nconst targetDay = dayMap[contentData.best_day] ?? 1;\nconst currentDay = today.getDay();\nlet daysUntilTarget = targetDay - currentDay;\nif (daysUntilTarget <= 0) daysUntilTarget += 7;\n\nconst scheduleDate = new Date(today);\nscheduleDate.setDate(today.getDate() + daysUntilTarget);\n\n// Parse best_time\nconst timeParts = contentData.best_time?.match(/(\\d+):(\\d+)\\s*(AM|PM)/i);\nif (timeParts) {\n  let hours = parseInt(timeParts[1]);\n  const minutes = parseInt(timeParts[2]);\n  const period = timeParts[3].toUpperCase();\n  if (period === 'PM' && hours !== 12) hours += 12;\n  if (period === 'AM' && hours === 12) hours = 0;\n  scheduleDate.setHours(hours, minutes, 0, 0);\n}\n\nreturn [{\n  json: {\n    ...contentData,\n    image_url: imageUrl,\n    scheduled_date: scheduleDate.toISOString(),\n    scheduled_date_readable: scheduleDate.toDateString() + ' at ' + contentData.best_time,\n    status: 'scheduled'\n  }\n}];"
      },
