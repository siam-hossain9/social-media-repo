      "parameters": {
        "jsCode": "// Generate weekly performance report\nconst allItems = $input.all();\n\nlet totalLikes = 0;\nlet totalShares = 0;\nlet totalComments = 0;\nlet totalClicks = 0;\nlet topContent = null;\nlet topScore = 0;\nlet viralCount = 0;\nlet highCount = 0;\n\nallItems.forEach(item => {\n  const analytics = item.json.analytics || {};\n  totalLikes += analytics.likes || 0;\n  totalShares += analytics.shares || 0;\n  totalComments += analytics.comments || 0;\n  totalClicks += analytics.clicks || 0;\n  \n  if ((analytics.engagement_score || 0) > topScore) {\n    topScore = analytics.engagement_score || 0;\n    topContent = item.json;\n  }\n  \n  if (analytics.performance_level === 'viral') viralCount++;\n  if (analytics.performance_level === 'high') highCount++;\n});\n\nconst totalPosts = allItems.length * 3; // 3 platforms\nconst avgEngagement = allItems.length > 0 \n  ? Math.round(allItems.reduce((sum, i) => sum + (i.json.analytics?.engagement_score || 0), 0) / allItems.length)\n  : 0;\n\nreturn [{\n  json: {\n    report: {\n      week_ending: new Date().toDateString(),\n      total_topics: allItems.length,\n      total_posts_scheduled: totalPosts,\n      total_likes: totalLikes,\n      total_shares: totalShares,\n      total_comments: totalComments,\n      total_clicks: totalClicks,\n      avg_engagement_score: avgEngagement,\n      viral_posts: viralCount,\n      high_performing_posts: highCount,\n      top_content_topic: topContent?.topic || 'N/A',\n      top_content_score: topScore,\n      generated_at: new Date().toISOString()\n    }\n  }\n}];"
      },
