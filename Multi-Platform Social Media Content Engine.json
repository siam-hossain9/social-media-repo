    {
      "parameters": {
        "jsCode": "// Parse Google Trends Response\nconst trendsRaw = $('Fetch Google Trends').item.json;\nconst twitterData = $('Fetch Twitter Trending').item.json;\n\n// Clean Google Trends data (remove )]}' prefix)\nlet trendsText = '';\ntry {\n  const rawText = trendsRaw.data || trendsRaw.body || '';\n  const cleanText = rawText.replace(')]}\\',\\n', '');\n  const trendsJson = JSON.parse(cleanText);\n  const trendingStories = trendsJson?.default?.trendingSearchesDays?.[0]?.trendingSearches || [];\n  \n  trendsText = trendingStories\n    .slice(0, 10)\n    .map(t => t.title?.query || '')\n    .filter(Boolean)\n    .join(', ');\n} catch(e) {\n  trendsText = 'AI, Machine Learning, Automation, Technology, Innovation, Digital Transformation, ChatGPT, Productivity';\n}\n\n// Parse Twitter trends\nlet twitterTrends = '';\ntry {\n  const tweets = twitterData?.data || [];\n  twitterTrends = tweets\n    .slice(0, 5)\n    .map(t => t.text?.substring(0, 100))\n    .join(' | ');\n} catch(e) {\n  twitterTrends = 'AI tools, automation workflows, productivity hacks';\n}\n\n// Get current date info\nconst now = new Date();\nconst monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nconst currentMonth = monthNames[now.getMonth()];\nconst currentYear = now.getFullYear();\nconst weekNumber = Math.ceil(now.getDate() / 7);\n\nreturn [{\n  json: {\n    googleTrends: trendsText,\n    twitterTrends: twitterTrends,\n    currentMonth: currentMonth,\n    currentYear: currentYear,\n    weekNumber: weekNumber,\n    timestamp: now.toISOString(),\n    niche: 'Technology & AI',\n    targetAudience: 'Tech professionals, entrepreneurs, and digital marketers'\n  }\n}];"
      },
      "id": "65a2d6cc-406f-45b1-bd2f-43ff5c16694d",
      "name": "Parse & Combine Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        400
      ]
    },
